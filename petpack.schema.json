{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dsh-hex-pet.dev/petpack.schema.json",
  "title": "dsh-hex-pet.pack/1 manifest",
  "type": "object",
  "required": ["id", "name", "animations"],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "type": "string",
      "const": "dsh-hex-pet.pack/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "author": {
      "type": "string",
      "maxLength": 128
    },
    "license": {
      "type": "string",
      "maxLength": 64
    },
    "animations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\.(webm|mov)$"
      }
    },
    "animationMeta": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fps": {
            "type": "integer",
            "minimum": 1,
            "maximum": 60
          },
          "mode": {
            "type": "string",
            "enum": ["loop", "once"]
          }
        }
      }
    },
    "preview": {
      "type": "string",
      "minLength": 1
    }
  }
}
